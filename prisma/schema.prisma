  evidence_items_image_regions_linked_evidence_idToevidence_items evidence_items?    @relation("image_regions_linked_evidence_idToevidence_items", fields: [linked_evidence_id], references: [evidence_id], onUpdate: NoAction)
  social_posts                                                    social_posts?      @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  crime_scenes                                                    crime_scenes?      @relation(fields: [scene_id], references: [scene_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([case_id], map: "ix_regions_case")
  @@index([linked_evidence_id], map: "ix_regions_linked_evidence")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model interview_messages {
  message_id                                                BigInt                    @id @default(autoincrement())
  session_id                                                BigInt
  sender_type                                               String                    @db.VarChar(15)
  message_type                                              String                    @default("normal") @db.VarChar(15)
  message_text                                              String
  confront_finding_id                                       BigInt?
  created_at                                                DateTime                  @default(now()) @db.Timestamptz(6)
  findings_findings_src_message_idTointerview_messages      findings[]                @relation("findings_src_message_idTointerview_messages")
  findings_interview_messages_confront_finding_idTofindings findings?                 @relation("interview_messages_confront_finding_idTofindings", fields: [confront_finding_id], references: [evidence_id], onUpdate: NoAction, map: "fk_msg_confront_finding")
  interview_sessions                                        interview_sessions        @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
  progress_revealed_facts                                   progress_revealed_facts[]
  timeline_events                                           timeline_events[]

  @@index([session_id, created_at], map: "ix_messages_session")
}

model interview_sessions {
  session_id         BigInt               @id @default(autoincrement())
  progress_id        BigInt
  person_id          BigInt
  started_at         DateTime             @default(now()) @db.Timestamptz(6)
  last_message_at    DateTime?            @db.Timestamptz(6)
  interview_messages interview_messages[]
  persons            persons              @relation(fields: [person_id], references: [person_id], onDelete: Cascade, onUpdate: NoAction)
  case_progress      case_progress        @relation(fields: [progress_id], references: [progress_id], onDelete: Cascade, onUpdate: NoAction)
  progress_activity  progress_activity[]

  @@unique([progress_id, person_id])
  @@index([progress_id, person_id], map: "ix_sessions_progress")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lab_comparisons {
  comparison_id                                                BigInt              @id @default(autoincrement())
  progress_id                                                  BigInt
  a_evidence_id                                                BigInt?
  a_post_id                                                    BigInt?
  a_frame_time_sec                                             Decimal?            @db.Decimal(8, 3)
