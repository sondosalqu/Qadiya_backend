generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model board_connections {
  connection_id                                           BigInt        @id @default(autoincrement())
  progress_id                                             BigInt
  from_node_id                                            BigInt
  to_node_id                                              BigInt
  relation_type                                           String        @db.VarChar(30)
  custom_label                                            String?       @db.VarChar(100)
  created_at                                              DateTime      @default(now()) @db.Timestamptz(6)
  board_nodes_board_connections_from_node_idToboard_nodes board_nodes   @relation("board_connections_from_node_idToboard_nodes", fields: [from_node_id], references: [node_id], onDelete: Cascade, onUpdate: NoAction)
  case_progress                                           case_progress @relation(fields: [progress_id], references: [progress_id], onDelete: Cascade, onUpdate: NoAction)
  board_nodes_board_connections_to_node_idToboard_nodes   board_nodes   @relation("board_connections_to_node_idToboard_nodes", fields: [to_node_id], references: [node_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([progress_id], map: "ix_board_conn_prog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model board_nodes {
  node_id                                                       BigInt               @id @default(autoincrement())
  progress_id                                                   BigInt
  person_id                                                     BigInt?
  evidence_id                                                   BigInt?
  statement_id                                                  BigInt?
  report_id                                                     BigInt?
  observation_id                                                BigInt?
  timeline_event_id                                             BigInt?
  note_label                                                    String?              @db.VarChar(200)
  pos_x                                                         Decimal              @default(0) @db.Decimal(10, 2)
  pos_y                                                         Decimal              @default(0) @db.Decimal(10, 2)
  color                                                         String?              @db.VarChar(20)
  created_at                                                    DateTime             @default(now()) @db.Timestamptz(6)
  board_connections_board_connections_from_node_idToboard_nodes board_connections[]  @relation("board_connections_from_node_idToboard_nodes")
  board_connections_board_connections_to_node_idToboard_nodes   board_connections[]  @relation("board_connections_to_node_idToboard_nodes")
  evidence_items                                                evidence_items?      @relation(fields: [evidence_id], references: [evidence_id], onDelete: Cascade, onUpdate: NoAction)
  police_observations                                           police_observations? @relation(fields: [observation_id], references: [observation_id], onDelete: Cascade, onUpdate: NoAction)
  persons                                                       persons?             @relation(fields: [person_id], references: [person_id], onDelete: Cascade, onUpdate: NoAction)
  case_progress                                                 case_progress        @relation(fields: [progress_id], references: [progress_id], onDelete: Cascade, onUpdate: NoAction)
  police_reports                                                police_reports?      @relation(fields: [report_id], references: [report_id], onDelete: Cascade, onUpdate: NoAction)
  statements                                                    statements?          @relation(fields: [statement_id], references: [statement_id], onDelete: Cascade, onUpdate: NoAction)
  timeline_events                                               timeline_events?     @relation(fields: [timeline_event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_board_timeline")

  @@unique([progress_id, evidence_id], map: "uq_board_evidence", where: raw("(evidence_id IS NOT NULL)"))
  @@unique([progress_id, person_id], map: "uq_board_person", where: raw("(person_id IS NOT NULL)"))
  @@unique([progress_id, statement_id], map: "uq_board_statement", where: raw("(statement_id IS NOT NULL)"))
  @@index([progress_id], map: "ix_board_nodes_prog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model case_progress {
  progress_id                            BigInt                    @id @default(autoincrement())
  case_id                                BigInt
  user_id                                BigInt
  assigned_by                            BigInt?
  assigned_at                            DateTime                  @default(now()) @db.Timestamptz(6)
  status                                 String                    @default("assigned") @db.VarChar(20)
  points_remaining                       Int
  is_admin_preview                       Boolean                   @default(false)
  started_at                             DateTime?                 @db.Timestamptz(6)
  last_activity_at                       DateTime?                 @db.Timestamptz(6)
  completed_at                           DateTime?                 @db.Timestamptz(6)
  finding_seq                            Int                       @default(0)
  board_connections                      board_connections[]
  board_nodes                            board_nodes[]
  users_case_progress_assigned_byTousers users?                    @relation("case_progress_assigned_byTousers", fields: [assigned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  cases                                  cases                     @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  users_case_progress_user_idTousers     users                     @relation("case_progress_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  evidence_items                         evidence_items[]
  final_conclusions                      final_conclusions?
  findings                               findings[]
  interview_sessions                     interview_sessions[]
  lab_comparisons                        lab_comparisons[]
  notebook_notes                         notebook_notes[]
  progress_activity                      progress_activity[]
  progress_revealed_facts                progress_revealed_facts[]
  progress_unlocks                       progress_unlocks[]
  timeline_conflicts                     timeline_conflicts[]
  timeline_events                        timeline_events[]

  @@unique([case_id, user_id])
  @@unique([progress_id, case_id])
  @@index([user_id], map: "ix_progress_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model case_solutions {
  case_id                BigInt                   @id
  solution_narrative     String
  w_people               Decimal                  @default(0.35) @db.Decimal(4, 2)
  w_evidence             Decimal                  @default(0.25) @db.Decimal(4, 2)
  w_timeline             Decimal                  @default(0.20) @db.Decimal(4, 2)
  w_relationships        Decimal                  @default(0.10) @db.Decimal(4, 2)
  w_efficiency           Decimal                  @default(0.10) @db.Decimal(4, 2)
  cases                  cases                    @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  solution_clues         solution_clues[]
  solution_culprits      solution_culprits[]
  solution_relationships solution_relationships[]
  solution_timeline      solution_timeline[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cases {
  case_id                                 BigInt                @id @default(autoincrement())
  case_number                             String                @unique @db.VarChar(30)
  title                                   String                @db.VarChar(200)
  short_description                       String?
  case_type                               String                @db.VarChar(50)
  case_status                             String                @default("unsolved") @db.VarChar(20)
  priority                                String                @default("medium") @db.VarChar(10)
  incident_at                             DateTime?             @db.Timestamptz(6)
  incident_location                       String?               @db.VarChar(255)
  victim_person_id                        BigInt?
  summary_text                            String?
  official_status                         String?               @db.VarChar(100)
  initial_brief                           String?
  cover_image_url                         String?
  initial_points                          Int                   @default(100)
  cost_start_interview                    Int                   @default(5)
  cost_confront                           Int                   @default(2)
  cost_visual_comparison                  Int                   @default(5)
  cost_advanced_enhance                   Int                   @default(3)
  publish_status                          String                @default("draft") @db.VarChar(20)
  created_by                              BigInt
  created_at                              DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime              @default(now()) @db.Timestamptz(6)
  case_progress                           case_progress[]
  case_solutions                          case_solutions?
  users                                   users                 @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  persons_cases_victim_person_idTopersons persons?              @relation("cases_victim_person_idTopersons", fields: [victim_person_id], references: [person_id], onUpdate: NoAction, map: "fk_cases_victim")
  clues                                   clues[]
  comparison_rules                        comparison_rules[]
  crime_scenes                            crime_scenes[]
  evidence_items                          evidence_items[]
  image_regions                           image_regions[]
  person_connections                      person_connections[]
  persons_persons_case_idTocases          persons[]             @relation("persons_case_idTocases")
  police_observations                     police_observations[]
  police_reports                          police_reports[]
  social_posts                            social_posts[]
  statements                              statements[]
  unlock_rules                            unlock_rules[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model character_knowledge {
  knowledge_id            BigInt                    @id @default(autoincrement())
  person_id               BigInt
  fact_text               String
  disclosure              String                    @db.VarChar(20)
  reveal_clue_id          BigInt?
  is_truthful             Boolean                   @default(true)
  persons                 persons                   @relation(fields: [person_id], references: [person_id], onDelete: Cascade, onUpdate: NoAction)
  clues                   clues?                    @relation(fields: [reveal_clue_id], references: [clue_id], onUpdate: NoAction, map: "fk_knowledge_clue")
  progress_revealed_facts progress_revealed_facts[]
}

model clues {
  clue_id                                                           BigInt                   @id @default(autoincrement())
  case_id                                                           BigInt
  code                                                              String                   @db.VarChar(30)
  title                                                             String                   @db.VarChar(200)
  description                                                       String?
  evidence_id                                                       BigInt?
  character_knowledge                                               character_knowledge[]
  cases                                                             cases                    @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  evidence_items                                                    evidence_items?          @relation(fields: [evidence_id], references: [evidence_id], onUpdate: NoAction)
  comparison_rules                                                  comparison_rules[]
  findings                                                          findings[]
  image_regions                                                     image_regions[]
  solution_clues                                                    solution_clues[]
  solution_relationships_solution_relationships_from_clue_idToclues solution_relationships[] @relation("solution_relationships_from_clue_idToclues")
  solution_relationships_solution_relationships_to_clue_idToclues   solution_relationships[] @relation("solution_relationships_to_clue_idToclues")
  solution_timeline                                                 solution_timeline[]
  unlock_rules                                                      unlock_rules[]

  @@unique([case_id, code])
  @@index([evidence_id], map: "ix_clues_evidence")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comparison_rules {
  rule_id                                                   BigInt            @id @default(autoincrement())
  case_id                                                   BigInt
  region_a_id                                               BigInt
  region_b_id                                               BigInt
  min_similarity                                            Decimal           @default(0.600) @db.Decimal(4, 3)
  result_clue_id                                            BigInt
  cases                                                     cases             @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  image_regions_comparison_rules_region_a_idToimage_regions image_regions     @relation("comparison_rules_region_a_idToimage_regions", fields: [region_a_id], references: [region_id], onDelete: Cascade, onUpdate: NoAction)
  image_regions_comparison_rules_region_b_idToimage_regions image_regions     @relation("comparison_rules_region_b_idToimage_regions", fields: [region_b_id], references: [region_id], onDelete: Cascade, onUpdate: NoAction)
  clues                                                     clues             @relation(fields: [result_clue_id], references: [clue_id], onDelete: Cascade, onUpdate: NoAction)
  lab_comparisons                                           lab_comparisons[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conclusion_events {
  conclusion_id     BigInt
  event_id          BigInt
  order_index       Int
  final_conclusions final_conclusions @relation(fields: [conclusion_id], references: [conclusion_id], onDelete: Cascade, onUpdate: NoAction)
  timeline_events   timeline_events   @relation(fields: [event_id], references: [event_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conclusion_id, event_id])
  @@unique([conclusion_id, order_index])
}

model conclusion_findings {
  conclusion_id     BigInt
  finding_id        BigInt
  final_conclusions final_conclusions @relation(fields: [conclusion_id], references: [conclusion_id], onDelete: Cascade, onUpdate: NoAction)
  findings          findings          @relation(fields: [finding_id], references: [evidence_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conclusion_id, finding_id])
}

model conclusion_people {
  conclusion_id     BigInt
  person_id         BigInt
  final_conclusions final_conclusions @relation(fields: [conclusion_id], references: [conclusion_id], onDelete: Cascade, onUpdate: NoAction)
  persons           persons           @relation(fields: [person_id], references: [person_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conclusion_id, person_id])
}

model crime_scenes {
  scene_id            BigInt          @id @default(autoincrement())
  case_id             BigInt
  title               String          @db.VarChar(200)
  description         String?
  image_url           String
  image_width         Int?
  image_height        Int?
  display_order       Int             @default(0)
  is_hidden_initially Boolean         @default(false)
  code                String?         @db.VarChar(30)
  cases               cases           @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  findings            findings[]
  image_regions       image_regions[]
  unlock_rules        unlock_rules[]

  @@unique([case_id, code], map: "uq_scene_code")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evidence_items {
  evidence_id                                                    BigInt                @id @default(autoincrement())
  case_id                                                        BigInt
  origin_type                                                    String                @db.VarChar(20)
  progress_id                                                    BigInt?
  media_type                                                     String                @db.VarChar(20)
  title                                                          String                @db.VarChar(200)
  description                                                    String?
  source                                                         String?               @db.VarChar(150)
  associated_person_id                                           BigInt?
  status                                                         String                @default("available") @db.VarChar(30)
  file_url                                                       String?
  thumbnail_url                                                  String?
  collected_at                                                   DateTime?             @db.Timestamptz(6)
  collected_location                                             String?               @db.VarChar(200)
  is_hidden_initially                                            Boolean               @default(false)
  display_order                                                  Int                   @default(0)
  created_at                                                     DateTime              @default(now()) @db.Timestamptz(6)
  code                                                           String?               @db.VarChar(20)
  board_nodes                                                    board_nodes[]
  clues                                                          clues[]
  persons                                                        persons?              @relation(fields: [associated_person_id], references: [person_id], onUpdate: NoAction)
  cases                                                          cases                 @relation(fields: [case_id], references: [case_id], onDelete: Cascade, onUpdate: NoAction)
  case_progress                                                  case_progress?        @relation(fields: [progress_id, case_id], references: [progress_id, case_id], onDelete: Cascade, onUpdate: NoAction)
  findings_findings_evidence_id_progress_idToevidence_items      findings?             @relation("findings_evidence_id_progress_idToevidence_items")
  findings_findings_src_evidence_idToevidence_items              findings[]            @relation("findings_src_evidence_idToevidence_items")
  image_regions                                                  image_regions[]
  image_regions_image_regions_linked_evidence_idToevidence_items image_regions[]       @relation("image_regions_linked_evidence_idToevidence_items")
  lab_comparisons_lab_comparisons_a_evidence_idToevidence_items  lab_comparisons[]     @relation("lab_comparisons_a_evidence_idToevidence_items")
  lab_comparisons_lab_comparisons_b_evidence_idToevidence_items  lab_comparisons[]     @relation("lab_comparisons_b_evidence_idToevidence_items")
  note_attachments                                               note_attachments[]
  police_observations                                            police_observations[]
  progress_activity                                              progress_activity[]
  solution_timeline                                              solution_timeline[]
  timeline_events                                                timeline_events[]
  unlock_rules                                                   unlock_rules[]

  @@unique([evidence_id, progress_id])
  @@unique([case_id, code], map: "uq_evidence_code")
  @@index([case_id, origin_type], map: "ix_evidence_case")
  @@index([progress_id], map: "ix_evidence_progress", where: raw("(progress_id IS NOT NULL)"))
}

model final_conclusions {
  conclusion_id       BigInt                @id @default(autoincrement())
  progress_id         BigInt                @unique
  reasoning_text      String
  submitted_at        DateTime?             @db.Timestamptz(6)
  score_people        Decimal?              @db.Decimal(5, 2)
  score_evidence      Decimal?              @db.Decimal(5, 2)
  score_timeline      Decimal?              @db.Decimal(5, 2)
  score_relationships Decimal?              @db.Decimal(5, 2)
  score_efficiency    Decimal?              @db.Decimal(5, 2)
  overall_score       Decimal?              @db.Decimal(5, 2)
  result_details      Json?
  conclusion_events   conclusion_events[]
  conclusion_findings conclusion_findings[]
  conclusion_people   conclusion_people[]
  case_progress       case_progress         @relation(fields: [progress_id], references: [progress_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model findings {
  evidence_id                                                         BigInt                @id
  progress_id                                                         BigInt
  display_code                                                        String                @db.VarChar(10)
  created_via                                                         String                @db.VarChar(25)
  src_scene_id                                                        BigInt?
  src_evidence_id                                                     BigInt?
  src_post_id                                                         BigInt?
  src_comparison_id                                                   BigInt?
  src_message_id                                                      BigInt?
  sel_x                                                               Decimal?              @db.Decimal(6, 5)
  sel_y                                                               Decimal?              @db.Decimal(6, 5)
  sel_w                                                               Decimal?              @db.Decimal(6, 5)
  sel_h                                                               Decimal?              @db.Decimal(6, 5)
  crop_url                                                            String?
  ocr_text                                                            String?
  matched_region_id                                                   BigInt?
  clue_id                                                             BigInt?
  conclusion_findings                                                 conclusion_findings[]
  clues                                                               clues?                @relation(fields: [clue_id], references: [clue_id], onUpdate: NoAction)
  evidence_items_findings_evidence_id_progress_idToevidence_items     evidence_items        @relation("findings_evidence_id_progress_idToevidence_items", fields: [evidence_id, progress_id], references: [evidence_id, progress_id], onDelete: Cascade, onUpdate: NoAction)
  image_regions                                                       image_regions?        @relation(fields: [matched_region_id], references: [region_id], onUpdate: NoAction)
  case_progress                                                       case_progress         @relation(fields: [progress_id], references: [progress_id], onDelete: Cascade, onUpdate: NoAction)
  lab_comparisons_findings_src_comparison_idTolab_comparisons         lab_comparisons?      @relation("findings_src_comparison_idTolab_comparisons", fields: [src_comparison_id], references: [comparison_id], onUpdate: NoAction)
  evidence_items_findings_src_evidence_idToevidence_items             evidence_items?       @relation("findings_src_evidence_idToevidence_items", fields: [src_evidence_id], references: [evidence_id], onUpdate: NoAction)
  interview_messages_findings_src_message_idTointerview_messages      interview_messages?   @relation("findings_src_message_idTointerview_messages", fields: [src_message_id], references: [message_id], onUpdate: NoAction)
  social_posts                                                        social_posts?         @relation(fields: [src_post_id], references: [post_id], onUpdate: NoAction)
  crime_scenes                                                        crime_scenes?         @relation(fields: [src_scene_id], references: [scene_id], onUpdate: NoAction)
  interview_messages_interview_messages_confront_finding_idTofindings interview_messages[]  @relation("interview_messages_confront_finding_idTofindings")
  lab_comparisons_lab_comparisons_saved_finding_idTofindings          lab_comparisons[]     @relation("lab_comparisons_saved_finding_idTofindings")

  @@unique([progress_id, display_code])
  @@unique([evidence_id, progress_id], map: "uq_findings_evidence_progress")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model image_regions {
  region_id                                                       BigInt             @id @default(autoincrement())
  case_id                                                         BigInt
  scene_id                                                        BigInt?
  evidence_id                                                     BigInt?
  post_id                                                         BigInt?
  region_type                                                     String             @db.VarChar(20)
  x                                                               Decimal            @db.Decimal(6, 5)
  y                                                               Decimal            @db.Decimal(6, 5)
  w                                                               Decimal            @db.Decimal(6, 5)
  h                                                               Decimal            @db.Decimal(6, 5)
  observed_details                                                String?
  revealed_text                                                   String?
  enhanced_image_url                                              String?
  clue_id                                                         BigInt?
  min_overlap                                                     Decimal            @default(0.30) @db.Decimal(3, 2)
  linked_evidence_id                                              BigInt?
  crop_url                                                        String?
  comparison_rules_comparison_rules_region_a_idToimage_regions    comparison_rules[] @relation("comparison_rules_region_a_idToimage_regions")
  comparison_rules_comparison_rules_region_b_idToimage_regions    comparison_rules[] @relation("comparison_rules_region_b_idToimage_regions")
  findings                                                        findings[]
